# AgentCore HTTPS edge — example Caddy site block.
# Copy or include from your Caddyfile. Run ensure_certs.sh first to export cert paths.
#
# Required env (ensure_certs.sh sets cert/key; operator sets hostname):
#   AGENTCORE_PUBLIC_HOSTNAME — public DNS name clients use (default: localhost)
#   AGENTCORE_TLS_CERT         — leaf certificate PEM path
#   AGENTCORE_TLS_KEY          — leaf private key PEM path
#
# Optional backend ports (defaults match AgentCore port profile):
#   AGENTCORE_MCP_HTTP_PORT=32500
#   AGENTCORE_PROJECT_PROFILE_PORT=32194

{$AGENTCORE_PUBLIC_HOSTNAME:localhost} {
	tls {$AGENTCORE_TLS_CERT} {$AGENTCORE_TLS_KEY}

	handle /mcp* {
		reverse_proxy 127.0.0.1:{$AGENTCORE_MCP_HTTP_PORT:32500}
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:{$AGENTCORE_PROJECT_PROFILE_PORT:32194}
	}
}
