# Sibling of the install root by default (e.g. /opt/AgentCore → /opt/AgentCore-data).
# Install / agentcore service start writes the resolved path; override if needed.
AGENTCORE_DATA_ROOT=/opt/AgentCore-data
AGENTCORE_POSTGRES_DATABASE=agentcore
AGENTCORE_POSTGRES_USER=agentcore
AGENTCORE_POSTGRES_PASSWORD=replace-with-a-local-secret
AGENTCORE_POSTGRES_PORT=32232
AGENTCORE_NEO4J_USER=neo4j
AGENTCORE_NEO4J_PASSWORD=replace-with-a-local-secret
AGENTCORE_NEO4J_BOLT_PORT=32287
AGENTCORE_NEO4J_HTTP_PORT=32474
# Plugins are enabled in compose.yaml (APOC + Graph Data Science Community).
# App-side GDS usage (optional degree ranking) — defaults ON, 4-core Community cap:
# AGENTCORE_NEO4J_GDS_ENABLED=true
# AGENTCORE_NEO4J_GDS_CONCURRENCY=4
#
# Optional Stage-2 ANN (Turbovec) — set in repo-root .env (not required for Compose infra).
# Default off. See .env.example and docs/13-technology-stack-and-platform-decisions/11-turbovec-for-rag.md
# AGENTCORE_RAG_ANN_ACCELERATOR=off
