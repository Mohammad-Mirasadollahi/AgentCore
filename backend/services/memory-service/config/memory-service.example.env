AGENTCORE_MEMORY_SERVICE_DATABASE_URL=postgresql://agentcore:change-me@postgres:5432/agentcore
AGENTCORE_MEMORY_PROFILE_ID=default-memory-profile
AGENTCORE_MEMORY_PROFILE_VERSION=1
AGENTCORE_MEMORY_CONTEXT_TOKEN_BUDGET=1200
# Optional Stage-2 ANN (default off). Prefer repo-root .env for operators
# (install.sh / agentcore loads root .env). Requires: pip install '.[turbovec]'
# AGENTCORE_RAG_ANN_ACCELERATOR=turbovec
# AGENTCORE_TURBOVEC_BIT_WIDTH=4
# AGENTCORE_TURBOVEC_SNAPSHOT_URI=/var/lib/agentcore/memory-ann.tvim
# AGENTCORE_TURBOVEC_SYNC_MODE=sync_on_write
# AGENTCORE_EMBEDDING_DIMS=1024
